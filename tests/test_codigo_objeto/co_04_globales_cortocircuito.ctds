// Globales (inicializadas en cero) y local que oculta una global, cortocircuito con
// efectos visibles (efecto imprime su argumento), void sin return, parametro modificado,
// llamadas con 7 y 8 argumentos (con y sin relleno de pila) y llamadas anidadas
extern void printInt(int x);

int g;
boolean b;

boolean efecto(int v) {
    printInt(v);
    return v > 0;
}

void incrementar() { g = g + 1; }

void mostrarG() { printInt(g); }

int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

int sumaOcho(int a, int b, int c, int d, int e, int f, int h, int i) {
    return a + b + c + d + e + f + h + i;
}

int sumaSiete(int a, int b, int c, int d, int e, int f, int h) {
    h = h * 10;
    return a + b + c + d + e + f + h;
}

void main() {
    int g;

    g = 5;
    incrementar();
    incrementar();
    printInt(g);             // la local
    mostrarG();              // la global
    b = efecto(1) && efecto(0) && efecto(2);   // no evalua efecto(2)
    b = efecto(3) || efecto(4);                // no evalua efecto(4)
    b = efecto(-1) || efecto(5);               // evalua los dos
    if (b && !efecto(0)) { printInt(100); } else { printInt(200); }
    printInt(sumaOcho(1, 2, 3, 4, 5, 6, 7, 8));
    printInt(sumaSiete(1, 1, 1, 1, 1, 1, sumaOcho(0, 0, 0, 0, 0, 0, 0, fib(6))));
}
