// Llamadas sin argumentos, con argumentos, como sentencia y como expresion,
// anidadas; return con valor, sin valor, y metodos void con y sin return
int dos() { return 2; }

int inc(int n) { return n + 1; }

int suma(int a, int b) { return a + b; }

void mostrar(int v) {
    int t;
    t = v;
}

void vacio() { }

void salida(int v) {
    if (v > 0) { return; }
    mostrar(v);
}

void main() {
    int x;
    int y;

    x = dos();
    y = inc(x);
    x = suma(x, inc(y));
    y = inc(inc(inc(1)));
    x = suma(inc(1), suma(2, dos())) + 1;
    mostrar(x);
    vacio();
    salida(y);
    return;
}
