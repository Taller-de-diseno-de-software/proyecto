enter main
x = 7
y = x
t1 = y * 2
t2 = x + t1
a = t2
t3 = x + y
t4 = t3 * 2
b = t4
t5 = -a
t6 = b % 3
t7 = t5 + t6
t8 = y / 2
t9 = t7 - t8
x = t9
t10 = x < y
p = t10
t12 = x > 3
t11 = t12
ifFalse t11 goto L1
t13 = !p
t11 = t13
L1:
q = t11
t14 = p
t15 = !t14
ifFalse t15 goto L2
t16 = q == 1
t14 = t16
L2:
ok = t14
t18 = x == y
t19 = !t18
t17 = t19
ifFalse t17 goto L3
t21 = a > b
t20 = t21
t22 = !t20
ifFalse t22 goto L4
t20 = p
L4:
t17 = t20
L3:
ok = t17
return
leave
